<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest Version="7.0"
                   ExtensionBundleId="com.clownsplit.cep"
                   ExtensionBundleVersion="1.0.0"
                   ExtensionBundleName="Clown Splitter">
    <ExtensionList>
        <Extension Id="com.clownsplit.cep.panel" Version="1.0.0"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PHXS" Version="[22.0,99.9]"/>
            <Host Name="PHSP" Version="[22.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.clownsplit.cep.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./host/index.html</MainPath>
                    <ScriptPath>./host/jsx/clownSplitter.jsx</ScriptPath>
                    <CEFCommandLine>
                        <!-- 让 file:// 页面能读本地临时 PNG 的像素，canvas 才不会被污染 -->
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Clown 分层</Menu>
                    <Geometry>
                        <Size>
                            <Height>700</Height>
                            <Width>340</Width>
                        </Size>
                        <MinSize>
                            <Height>340</Height>
                            <Width>300</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>1600</Height>
                            <Width>1600</Width>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
